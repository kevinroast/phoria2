{
  "name": "phoria2",
  "version": "1.0.0-rc.3",
  "description": "Small, friendly 3D for the web - a WebGL 2 renderer with charts, labels, picking, particles and glTF",
  "keywords": [
    "3d",
    "webgl",
    "webgl2",
    "3d-charts",
    "data-visualization",
    "charts",
    "scene-graph",
    "gltf",
    "pbr",
    "particles"
  ],
  "homepage": "https://kevs3d.co.uk/phoria2/",
  "bugs": {
    "url": "https://github.com/kevinroast/phoria2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinroast/phoria2.git"
  },
  "author": "Kevin Roast",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "schema"
  ],
  "sideEffects": false,
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/phoria2.js"
    },
    "./particles": {
      "types": "./dist/types/particles/index.d.ts",
      "import": "./dist/particles.js"
    },
    "./charts": {
      "types": "./dist/types/charts/index.d.ts",
      "import": "./dist/charts.js"
    },
    "./gltf": {
      "types": "./dist/types/gltf/index.d.ts",
      "import": "./dist/gltf.js"
    },
    "./motion": {
      "types": "./dist/types/motion/index.d.ts",
      "import": "./dist/motion.js"
    },
    "./charts/schema.json": "./schema/chart.schema.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.json",
    "build:demos": "vite build --mode demos",
    "preview": "vite preview --outDir dist-demos",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.demos.json",
    "lint": "eslint .",
    "size": "node scripts/size.mjs",
    "perf": "node perf/run.mjs",
    "thumbs": "node scripts/thumbs.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "gl-matrix": "^3.4.4",
    "globals": "^17.6.0",
    "three": "0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.5"
  }
}
