{
  "name": "phoria2",
  "version": "2.0.0-alpha.0",
  "description": "Small, friendly 3D for the web",
  "author": "Kevin Roast",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "schema"
  ],
  "sideEffects": false,
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/phoria2.js"
    },
    "./particles": {
      "types": "./dist/types/particles/index.d.ts",
      "import": "./dist/particles.js"
    },
    "./charts": {
      "types": "./dist/types/charts/index.d.ts",
      "import": "./dist/charts.js"
    },
    "./charts/schema.json": "./schema/chart.schema.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.json",
    "build:demos": "vite build --mode demos",
    "preview": "vite preview --outDir dist-demos",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.demos.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "gl-matrix": "^3.4.4",
    "globals": "^17.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.5"
  }
}
